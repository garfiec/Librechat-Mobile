<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        TCHAT: cleartext is refused in every build, debug included. Upstream Switchboard permits
        it unconditionally because its server URL is user-entered and may be a local HTTP server
        (http://192.168.x.x:3080). This build's server URL is unconditionally pinned to
        https://chat.tensorgrid.space (see core/brand/di/BrandModule.kt) with no in-app way to
        point anywhere else, in any build — so there is nothing left to permit.
    -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
