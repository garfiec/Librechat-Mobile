<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- What's new opens the store that installed the app (AndroidAppInstallSource). Android 11+
         hides other packages, so without these the launch intent resolves to nothing. Keep in step
         with the package sets in AndroidAppInstallSource. Open-source flavor only: a store build
         has no What's new screen and never asks which app installed it. -->
    <queries>
        <package android:name="dev.imranr.obtainium" />
        <package android:name="dev.imranr.obtainium.fdroid" />
        <package android:name="org.fdroid.fdroid" />
        <package android:name="org.fdroid.basic" />
        <package android:name="com.looker.droidify" />
        <package android:name="com.machiav3lli.fdroid" />
    </queries>

</manifest>
