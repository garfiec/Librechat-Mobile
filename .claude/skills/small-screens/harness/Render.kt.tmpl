// TEMP-RENDER: generated by .claude/skills/small-screens/scripts/render.py. Never commit.
@RunWith(RobolectricTestRunner::class)
@GraphicsMode(GraphicsMode.Mode.NATIVE)
@Config(sdk = [35])
class TempSmallScreenRender {
    @get:Rule val rule = createEmptyComposeRule()

    private val out = File("__OUT__").apply { mkdirs() }
    private val failures = mutableListOf<String>()

    /**
     * One render. The window is exactly [width]×[height]dp at [scale] in [locale], set through the
     * Robolectric qualifiers and font scale, so text scales non-linearly as on an API 34+ device
     * and stringResource follows the locale. A dialog capture takes the dialog window; a root
     * capture takes the activity, which is where glass dialogs and sheets draw.
     */
    private fun shot(
        name: String,
        width: Int,
        height: Int,
        scale: Float,
        locale: String?,
        dialog: Boolean,
        scrolled: Boolean,
        content: @Composable () -> Unit,
    ) {
        try {
            RuntimeEnvironment.setQualifiers(listOfNotNull(locale, "w${width}dp", "h${height}dp", "xhdpi").joinToString("-"))
            RuntimeEnvironment.setFontScale(scale)
            java.util.Locale.setDefault(java.util.Locale.forLanguageTag(locale ?: "en"))
            ActivityScenario.launch(ComponentActivity::class.java).use { sc ->
                // A manual clock: a dialog holding a text field never reports idle under the
                // auto-advancing one. Two seconds settles every opening animation.
                rule.mainClock.autoAdvance = false
                sc.onActivity { it.setContent { Box(Modifier.width(width.dp)) { content() } } }
                rule.mainClock.advanceTimeBy(2000)
                save(name, capture(dialog))
                if (scrolled) {
                    runCatching {
                        val node = if (dialog) rule.onNode(isDialog()) else rule.onRoot()
                        repeat(3) {
                            node.performTouchInput { swipeUp(startY = height * 0.7f, endY = height * 0.2f, durationMillis = 300) }
                            rule.mainClock.advanceTimeBy(1000)
                        }
                        save("$name-scrolled", capture(dialog))
                    }.recoverCatching {
                        swipeNewestWindow()
                        save("$name-scrolled", drawNewestWindow())
                    }.onFailure { failures += "$name scrolled: $it" }
                }
                rule.mainClock.autoAdvance = true
            }
        } catch (t: Throwable) {
            failures += "$name: $t"
            t.printStackTrace()
        }
    }

    private fun capture(dialog: Boolean): Bitmap =
        if (dialog) {
            runCatching { rule.onNode(isDialog()).captureToImage().asAndroidBitmap() }.getOrElse { drawNewestWindow() }
        } else {
            rule.onRoot().captureToImage().asAndroidBitmap()
        }

    private fun save(name: String, bmp: Bitmap) {
        File(out, "$name.png").outputStream().use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
    }

    /** The newest window with a size: the dialog's, when a Material dialog never idles. */
    private fun newestWindow(): android.view.View {
        val cls = Class.forName("android.view.WindowManagerGlobal")
        val inst = cls.getMethod("getInstance").invoke(null)
        val field = cls.getDeclaredField("mViews").apply { isAccessible = true }
        @Suppress("UNCHECKED_CAST")
        val views = field.get(inst) as List<android.view.View>
        return views.last { it.width > 0 && it.height > 0 }
    }

    private fun drawNewestWindow(): Bitmap {
        val v = newestWindow()
        val b = Bitmap.createBitmap(v.width.coerceAtLeast(1), v.height.coerceAtLeast(1), Bitmap.Config.ARGB_8888)
        v.draw(android.graphics.Canvas(b))
        return b
    }

    private fun swipeNewestWindow() {
        val v = newestWindow()
        val x = v.width / 2f
        repeat(3) {
            val t0 = android.os.SystemClock.uptimeMillis()
            fun ev(action: Int, y: Float, dt: Long) =
                android.view.MotionEvent.obtain(t0, t0 + dt, action, x, y, 0).also { e -> v.dispatchTouchEvent(e); e.recycle() }
            ev(android.view.MotionEvent.ACTION_DOWN, v.height * 0.7f, 0)
            for (i in 1..10) {
                ev(android.view.MotionEvent.ACTION_MOVE, v.height * (0.7f - 0.05f * i), i * 16L)
                rule.mainClock.advanceTimeBy(16)
            }
            ev(android.view.MotionEvent.ACTION_UP, v.height * 0.2f, 176)
            rule.mainClock.advanceTimeBy(1000)
        }
    }

    @Test
    fun render() {
__CASES__
        File(out, "failures.txt").writeText(failures.joinToString("\n"))
    }
}
