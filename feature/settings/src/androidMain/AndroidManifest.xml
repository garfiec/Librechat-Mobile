<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without this, a TTS engine the user installed is invisible to us and the device voice list
         stays empty. Google's engine is force-queryable, so this only breaks on ROMs without it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
